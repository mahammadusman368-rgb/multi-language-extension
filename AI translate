function processWithAI(spokenText, callback)
    local apiKey = getGroqApiKey()
    
    if not apiKey or apiKey == "" then
        service.speak("Please set Groq API key in AI Engine settings first")
        callback(spokenText)
        return
    end
    
    local model = getGroqModel()
    local mode = getSelectedMode()
    local systemPrompt = ""
    
    if mode == "conversion" then
        systemPrompt = getConversionModePrompt()
        service.speak("Conversion Mode active")
    else
        systemPrompt = getIntelligentWriterPrompt()
        service.speak("Intelligent Writer Mode active")
    end
    
    -- اگر اسمارٹ ایموجی سوئچ آن ہو تو پرامپٹ میں ہر لفظ کو اسکین کر کے ایموجی لگانے کی انسٹرکشن شامل کریں
    if isSmartEmojiEnabled() then
        systemPrompt = systemPrompt .. "\nAdditional Rule: Scan every single word meticulously. Based on the exact meaning of each word, attach a highly relevant, context-aware emoji immediately after it. Ensure every appropriate word is enhanced with an emoji."
    end
    
    callGroqAPI(apiKey, model, systemPrompt, spokenText, function(result, error)
        if error then
            service.speak(error)
            callback(spokenText)
        else
            callback(result)
        end
    end)
end

function translateSpeechToTarget(spokenText, callback)
    local apiKey = getGroqApiKey()
    
    if not apiKey or apiKey == "" then
        callback("Please set Groq API key in AI Engine settings first")
        return
    end
    
    local model = getGroqModel()
    local targetLangCode = getTargetLanguage()
    local targetLangName = getTargetLanguageName()
    local systemPrompt = getTranslationPrompt(targetLangCode, targetLangName)
    
    if isSmartEmojiEnabled() then
        systemPrompt = systemPrompt .. "\nAdditional Rule: Scan every single translated word meticulously. Based on the exact meaning of each word, attach a highly relevant, context-aware emoji immediately after it."
    end
    
    callGroqAPI(apiKey, model, systemPrompt, spokenText, function(result, error)
        if error then
            callback("Translation error: " .. error)
        else
            callback(result)
        end
    end)
end

function translateScreenFocusText()
