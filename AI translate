        return false
    end

    local screenText = ""
    if node then
        screenText = node.text or node.contentDescription
    end
    
    if not screenText or tostring(screenText) == "" or tostring(screenText) == "nil" then
        local clipboard = service.getSystemService(Context.CLIPBOARD_SERVICE)
        if clipboard and clipboard.hasPrimaryClip() then
            local clipData = clipboard.getPrimaryClip()
            if clipData and clipData.getItemCount() > 0 then
                screenText = clipData.getItemAt(0).getText()
            end
        end
    end

    if not screenText or tostring(screenText) == "" or tostring(screenText) == "nil" then
        service.speak("Focused element has no text")
        return false
    end
    
    screenText = tostring(screenText)

    local apiKey = getGroqApiKey()
    if not apiKey or apiKey == "" then
        service.speak("Please set Groq API key for screen translation")
        return false
    end

    service.speak("Translating screen text...")
