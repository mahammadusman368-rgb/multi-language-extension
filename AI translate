-- Translation Prompt (from any language to target language)
function getTranslationPrompt(targetLangCode, targetLangName)
    local languageMap = {
        ["en-US"] = "English", ["ur-PK"] = "Urdu", ["hi-IN"] = "Hindi", ["ar-SA"] = "Arabic",
        ["es-ES"] = "Spanish", ["fr-FR"] = "French", ["de-DE"] = "German", ["zh-CN"] = "Chinese",
        ["ja-JP"] = "Japanese", ["tr-TR"] = "Turkish", ["ru-RU"] = "Russian", ["pt-BR"] = "Portuguese",
        ["it-IT"] = "Italian", ["nl-NL"] = "Dutch"
    }
    local targetLang = languageMap[targetLangCode] or targetLangName or "English"
    
    return [[Task: Act as a professional translator. Your goal is to translate the given text into ]] .. targetLang .. [[ language.
Instructions: 
1. Identify the source language of the input text automatically.
2. Translate the entire text accurately into ]] .. targetLang .. [[.
3. Keep the meaning, tone, and context intact.
4. Return ONLY the translation without any extra explanation, comments, or quotes.
5. If the text is already in ]] .. targetLang .. [[, return it as-is.]]
end

